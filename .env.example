# ---- Storage: MongoDB Atlas (leave unset for the labeled demo store) ----
MONGODB_URI=
MONGODB_DB=continuity
ATLAS_VECTOR_INDEX=memory_vector_index

# ---- Embeddings ----
# Option A (simplest): leave every key below empty and set MONGODB_URI. Atlas auto-embedding
#   (EMBEDDING_PROVIDER=atlas-auto) generates the Voyage vectors inside Atlas; no key in the app.
# Option B: a MongoDB Atlas Model API key (Atlas > AI Models > Model API Keys):
#   VOYAGE_API_KEY=<model api key>  VOYAGE_BASE_URL=https://ai.mongodb.com/v1  EMBEDDING_MODEL=voyage-4-lite
# Provider is inferred: voyage key, then openai key, then atlas-auto when MONGODB_URI is set, else demo.
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
# EMBEDDING_PROVIDER=atlas-auto    # atlas-auto | voyage | openai | demo
# EMBEDDING_MODEL=voyage-4-lite
# EMBEDDING_DIMENSIONS=1024        # must match the Atlas vector index (npm run atlas:setup)

# ---- Extraction & planning model (leave unset for the deterministic demo planner) ----
# Provider is inferred: OPENAI_API_KEY, then ANTHROPIC_API_KEY, else demo.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1             # any chat model with structured outputs
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# PLANNER_PROVIDER=openai          # openai | anthropic | demo

# Allow the "Reset demo data" button against Atlas (always on in demo mode)
ALLOW_DEMO_RESET=false

# Load the MongoDB Agents-in-Context hackathon dataset (data/hackathon) when seeding
# SEED_HACKATHON=true
